{
  "$schema": "https:\u002f\u002fjson-schema.org/draft/2020-12/schema",
  "$id": "urn:mgs1-ptbr-patcher:release-manifest:v1",
  "title": "MGS1 PT-BR release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "status",
    "patch_format",
    "discs"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["release-candidate", "released"]
    },
    "patch_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "specification", "implementation_license"],
      "properties": {
        "id": { "const": "BPS1" },
        "profile": { "const": "linear-streaming-v1" },
        "specification": { "type": "string", "format": "uri" },
        "implementation_license": { "const": "MIT" }
      }
    },
    "discs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/disc" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "size", "sha256"],
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$"
        },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "size", "sha256"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[.][.]/).+$"
        },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "filePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bin", "cue"],
      "properties": {
        "bin": { "$ref": "#/$defs/file" },
        "cue": { "$ref": "#/$defs/file" }
      }
    },
    "patchPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bin", "cue"],
      "properties": {
        "bin": { "$ref": "#/$defs/patch" },
        "cue": { "$ref": "#/$defs/patch" }
      }
    },
    "disc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "authority_date",
        "acceptance_scope",
        "source",
        "target",
        "patches"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "display_name": { "type": "string", "minLength": 1 },
        "authority_date": { "type": "string", "format": "date" },
        "acceptance_scope": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/filePair" },
        "target": { "$ref": "#/$defs/filePair" },
        "patches": { "$ref": "#/$defs/patchPair" }
      }
    }
  }
}
